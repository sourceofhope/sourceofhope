{
  "name": "thesourceofhope",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "scripts": {
    "dev:client": "vite",
    "dev:server": "npm run dev --prefix server",
    "dev": "start npm run dev:server && npm run dev:client",
    "build:client": "vite build && node --input-type=module --eval \"import fs from 'fs'; fs.copyFileSync('dist/index.html', 'dist/404.html')\"",
    "build:server": "npm install --prefix server",
    "build": "npm run build:client && npm run build:server",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.2",
    "react-icons": "^5.5.0",
    "vite": "^7.1.2"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@tailwindcss/vite": "^4.1.13",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-helmet-async": "^2.0.5",
    "react-router-dom": "^7.8.2",
    "tailwindcss": "^4.1.13"
  }
}
