# ─── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_SALES_TAX_RATE_ID=txr_...

# ─── PayPal ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_PAYPAL_CLIENT_ID=<your-paypal-client-id>
PAYPAL_CLIENT_SECRET=<your-paypal-client-secret>
# Values: production | development
PAYPAL_API=development

# ─── Frontend ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_FRONTEND_URL=https://yourdomain.com

# ─── Resend ───────────────────────────────────────────────────────────────────
RESEND_API_KEY=re_...

# ─── Sanity ───────────────────────────────────────────────────────────────────
SANITY_STUDIO_PROJECT_ID=<your-sanity-project-id>
SANITY_STUDIO_DATASET=production
NEXT_PUBLIC_SANITY_PROJECT_ID=<your-sanity-project-id>
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-04-10
SANITY_API_READ_TOKEN=

# ─── DocuSign (online volunteer waivers; optional) ────────────────────────────
# Online signing stays hidden until every value below is set.
# Setup: docs/recipes/guidelines/SET_UP_DOCUSIGN_WAIVERS.md
DOCUSIGN_INTEGRATION_KEY=<integration-key-guid>
DOCUSIGN_USER_ID=<impersonated-user-guid>
DOCUSIGN_ACCOUNT_ID=<account-guid>
# RSA private key: PEM with \n line breaks, or base64 of the PEM
DOCUSIGN_PRIVATE_KEY=
# Values: demo | production
DOCUSIGN_ENVIRONMENT=demo
# Optional; looked up automatically when unset (e.g. https://demo.docusign.net/restapi)
DOCUSIGN_BASE_URL=
DOCUSIGN_TEMPLATE_GENERAL_ADULT=<template-id>
DOCUSIGN_TEMPLATE_GENERAL_MINOR=<template-id>
DOCUSIGN_TEMPLATE_SERVING_HOPE_ADULT=<template-id>
DOCUSIGN_TEMPLATE_SERVING_HOPE_MINOR=<template-id>
# Connect HMAC key used to verify /api/waiver/webhook deliveries
DOCUSIGN_CONNECT_HMAC_KEY=
# Long random string used to sign the signing-session cookie (e.g. openssl rand -base64 32)
WAIVER_SECRET=
